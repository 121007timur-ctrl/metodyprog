# Конфигурация Doxygen для проекта metodyprog.
# Локальный запуск из корня репозитория:  doxygen Doxyfile
# Результат: docs/html/index.html

PROJECT_NAME           = "metodyprog"
PROJECT_BRIEF          = "Клиент-серверное приложение на Qt: авторизация, задания по численным методам, игра"
PROJECT_NUMBER         = 1.0
OUTPUT_DIRECTORY       = docs
OUTPUT_LANGUAGE        = Russian
INPUT_ENCODING         = UTF-8

INPUT                  = docs/mainpage.md server client tests
FILE_PATTERNS          = *.h *.cpp *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */build/* */.qtcreator/* */test_case/* */test/*
USE_MDFILE_AS_MAINPAGE = docs/mainpage.md

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_ANON_NSPACES   = NO
JAVADOC_AUTOBRIEF      = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_LOGFILE           = docs/doxygen-warnings.log

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
USE_MATHJAX            = YES
HAVE_DOT               = NO
CLASS_GRAPH            = YES

# --- Оформление: тема doxygen-awesome-css ---
# Подключение только через стили (без кастомного HTML-заголовка), чтобы сборка
# работала на любой версии Doxygen, включая 1.9.8 на GitHub Actions.
# Светлая база; тёмная тема включается автоматически по настройке ОС
# (prefers-color-scheme) — за это отвечает сама doxygen-awesome.css.
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
HTML_COLORSTYLE        = LIGHT

HTML_EXTRA_STYLESHEET  = docs/doxygen-awesome/doxygen-awesome.css \
                         docs/doxygen-awesome/doxygen-awesome-sidebar-only.css
